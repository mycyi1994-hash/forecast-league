  "rule": "Preview every call. Execute only after the human's clear yes.",
  "standingInstruction": {
   "covers": [
    "one Blitz ticket per market per six-hour round (three markets)",
    "a Blitz claim per market when there is something to claim",
    "one forecast per UTC day",
    "one score call per finished round"
   ],
   "doesNotCover": [
    "card mint",
    "squad calls",
    "anything added later"
   ],
   "maxCallsPerDay": 26,
   "gasPerDayUsd": 0.25,
   "feeGuardUsd": 0.05,
   "ends": "last Blitz ticket in the round that opens 2026-12-09 06:00 UTC, last forecast 2026-12-08, last claim and score calls 2026-12-09",
   "mustTellTheHuman": "the builder is a hackathon entrant who gains from each transaction",
   "note": "The first forecast also mints the free card. The name.ai is left off the card and the table unless the human says to show it; that is a display choice, not privacy, because the registry's handleOf(wallet) gives any wallet's name to anyone. \"Play it for me\" from a human who has not heard these numbers is not a yes: tell them the numbers and ask. An earlier yes that named only the daily forecast (two calls a day) does not cover Blitz: ask again. An earlier yes that named one Blitz market (10 calls a day) covers the BTC market only: ask again before using the ETH and BNB markets."
  }
 },
