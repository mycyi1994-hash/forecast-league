pragma solidity 0.8.28;

/// @title CardArtConstants
/// @notice Small per-tier values and the colour palettes of the player card.
/// @dev Generated by art/constants.cjs from art/card.cjs. Do not edit by hand.
abstract contract CardArtConstants {
    /// @dev 8 palettes x 4 colours (deep, mid, bright, accent) x 6 hex characters.
    bytes internal constant PALETTE = '0B10261D3FA84F8CFF8DF3FF160A2E5B1FA8B36BFFFF9EF505231B0B7A552EE6A0C8FF7A2A0808A81F2DFF5A5AFFC46B071F2A0B6E862FD9E6F7EE7A1F1203A8650BFFAE2EFFF39A0F10203B3F8F8E97FFE6E9FF24061CA80B7AFF4DB0FFD1EC';

    function _tierName(uint256 ti) internal pure returns (string memory) {
        if (ti == 0) return 'ROOKIE';
        if (ti == 1) return 'ANALYST';
        if (ti == 2) return 'STRATEGIST';
        return 'ORACLE';
    }

    function _frame(uint256 ti) internal pure returns (uint256) {
        if (ti == 0) return 14;
        if (ti == 1) return 17;
        if (ti == 2) return 21;
        return 24;
    }

    function _radius(uint256 ti) internal pure returns (uint256) {
        if (ti == 0) return 74;
        if (ti == 1) return 88;
        if (ti == 2) return 98;
        return 100;
    }

    function _blobOpacity(uint256 ti) internal pure returns (string memory) {
        if (ti == 0) return '.45';
        if (ti == 1) return '.7';
        if (ti == 2) return '.9';
        return '1';
    }

    function _glowOpacity(uint256 ti) internal pure returns (string memory) {
        if (ti == 0) return '';
        if (ti == 1) return '.3';
        if (ti == 2) return '.42';
        return '.55';
    }

    function _highlightOpacity(uint256 ti) internal pure returns (string memory) {
        if (ti == 0) return '.55';
        if (ti == 1) return '1';
        if (ti == 2) return '1';
        return '1';
    }

    function _pedestalGlow(uint256 ti) internal pure returns (string memory) {
        if (ti == 0) return '.25';
        if (ti == 1) return '.6';
        if (ti == 2) return '.6';
        return '.6';
    }
}
